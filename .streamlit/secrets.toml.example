# Vorlage für .streamlit/secrets.toml — diese Datei OHNE .example kopieren und
# ausfüllen. Die echte secrets.toml ist in .gitignore und gehört NICHT ins Repo.
#
# Solange diese Werte fehlen, ist der Veröffentlichen-Button in der App
# deaktiviert; Entwürfe lassen sich trotzdem anlegen und gestalten.
#
# Woher die Werte kommen: Meta Developer App (Typ Business) mit dem Produkt
# "Instagram API with Instagram Login". Siehe insta.md.

# Die Instagram-User-ID des Professional Accounts @math_uni_freiburg.
IG_USER_ID = ""

# Long-Lived Token aus dem App-Dashboard. ACHTUNG: läuft nach 60 Tagen ab und
# muss erneuert werden (GET /refresh_access_token). Ohne Refresh hört das Posten
# stillschweigend auf.
IG_ACCESS_TOKEN = ""

# Für den Token-Refresh.
IG_APP_ID = ""
IG_APP_SECRET = ""
